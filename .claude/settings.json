{
  "extraKnownMarketplaces": {
    "ov-plugins": {
      "source": {
        "source": "github",
        "repo": "overthinkos/overthink-plugins"
      }
    }
  },
  "enabledPlugins": {
    "ov-core@ov-plugins": true,
    "ov-jupyter@ov-plugins": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git submodule update --init --recursive"
          }
        ]
      }
    ]
  }
}
